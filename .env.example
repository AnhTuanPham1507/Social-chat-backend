APP_PORT=3000
APP_ENV=development

FRONTEND_URL=http://localhost:3001

# =============================================================================
# KONG API GATEWAY
# =============================================================================
KONG_PG_PASSWORD=kongpass
KONG_ADMIN_URL=http://localhost:8001
KONG_PROXY_URL=http://localhost:3000

# Service URLs (for Kong to route to)
AUTH_SERVICE_URL=http://host.docker.internal:3001
USER_SERVICE_URL=http://host.docker.internal:3002

# JWT Configuration for Kong
# This key must match the 'iss' claim in your JWT tokens
KONG_JWT_KEY=social-chat-jwt
KONG_JWT_ALGORITHM=HS256

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=social-chat-local
DB_SYNCHRONIZE=true

JWT_SECRET=abc
JWT_TOKEN_EXPIRE=15m
JWT_REFRESH_TOKEN_EXPIRE=7d

KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=social-chat
KEYCLOAK_AUTH_CALLBACK_URL=${APP_URL}/auth/callback
KEYCLOAK_SOCIAL_ID=social-chat
KEYCLOAK_SOCIAL_SECRET=ZjF56mcEeF2A1rP4KQpi5OLlJqu33ayD

MINIO_URL=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SSL=false

REDIS_CACHE_PASSWORD=ewqovxnzsa2438JFGSJFGbsad7dsa76asjj
REDIS_CACHE_HOST=localhost
REDIS_CACHE_TLS=
REDIS_CACHE_PORT=6379     
REDIS_CACHE_USERNAME=
REDIS_CACHE_PREFIX=CACHE

REDIS_SHARED_STORE_PASSWORD=ewqovxnzsa2438JFGSJFGbsad7dsa76asjj
REDIS_SHARED_STORE_HOST=localhost
REDIS_SHARED_STORE_TLS=
REDIS_SHARED_STORE_PORT=6379
REDIS_SHARED_STORE_USERNAME=
REDIS_SHARED_STORE_HOST_CLUSTER=
