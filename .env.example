# Multi-Client Configuration Examples
# Additional clients can be configured using the pattern:
# KEYCLOAK_CLIENT_<CLIENT_NAME>_ID, KEYCLOAK_CLIENT_<CLIENT_NAME>_SECRET, KEYCLOAK_CLIENT_<CLIENT_NAME>_CALLBACK_URL
# Client names are case-insensitive and will be normalized (e.g., WEB_APP -> web-app)

# Web application client
KEYCLOAK_CLIENT_WEB_ID=web-app-client
KEYCLOAK_CLIENT_WEB_SECRET=web-app-secret
KEYCLOAK_CLIENT_WEB_CALLBACK_URL=http://localhost:3000/auth/callback

# Mobile application client
KEYCLOAK_CLIENT_MOBILE_ID=mobile-app-client
KEYCLOAK_CLIENT_MOBILE_SECRET=mobile-app-secret
KEYCLOAK_CLIENT_MOBILE_CALLBACK_URL=http://localhost:3000/auth/callback

# Admin panel client
