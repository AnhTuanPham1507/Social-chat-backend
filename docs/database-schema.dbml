// Social Chat Backend - Database Schema
// Generated from database-schema.puml

Project SocialChatBackend {
  database_type: 'PostgreSQL'
  Note: 'Social Chat Backend Database Schema'
}

// ==================== ENUMS ====================

Enum user_sex {
  MALE
  FEMALE
  UNKNOWN
}

Enum asset_type {
  image
  video
  audio
  document
  unknown
}

Enum conversation_type {
  direct
  group
}

Enum participant_role {
  owner
  admin
  member
}

Enum message_type {
  text
  image
  video
  audio
  file
  location
  system
}

Enum message_status {
  sending
  sent
  delivered
  failed
}

Enum friendship_status {
  pending
  accepted
  blocked
  declined
}

Enum presence_status {
  online
  away
  busy
  offline
}

Enum reaction_type {
  like
  love
  haha
  wow
  sad
  angry
}

Enum post_visibility {
  public
  friends
  private
}

Enum notification_type {
  message
  friend_request
  friend_accepted
  post_like
  post_comment
  mention
  group_invite
}

// ==================== TABLES ====================

Table users {
  id uuid [pk]
  full_name varchar(255) [not null]
  email varchar(255) [not null, unique]
  phone varchar(20) [unique]
  sex user_sex [default: 'UNKNOWN']
  avatar_url text
  bio text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp

  indexes {
    email [name: 'idx_users_email']
    phone [name: 'idx_users_phone']
  }
}

Table assets {
  id uuid [pk]
  name varchar(255) [not null]
  url text [not null]
  size bigint [not null]
  asset_type asset_type [not null]
  mime_type varchar(100) [not null]
  metadata jsonb
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp
}

Table conversations {
  id uuid [pk]
  type conversation_type [not null]
  name varchar(255)
  description text
  avatar_url text
  last_message_id uuid
  last_message_at timestamp
  created_by_id uuid [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp

  indexes {
    type [name: 'idx_conversations_type']
    (last_message_at) [name: 'idx_conversations_last_message_at']
    created_by_id [name: 'idx_conversations_created_by']
  }
}

Table conversation_participants {
  id uuid [pk]
  conversation_id uuid [not null]
  user_id uuid [not null]
  role participant_role [default: 'member']
  nickname varchar(100)
  is_muted boolean [default: false]
  muted_until timestamp
  last_read_message_id uuid
  last_read_at timestamp
  joined_at timestamp [not null]
  left_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (conversation_id, user_id) [unique, name: 'idx_conversation_participants_unique']
  }
}

Table messages {
  id uuid [pk]
  conversation_id uuid [not null]
  sender_id uuid [not null]
  type message_type [default: 'text']
  content text
  status message_status [default: 'sent']
  reply_to_id uuid
  forwarded_from_id uuid
  is_edited boolean [default: false]
  edited_at timestamp
  metadata jsonb
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp

  indexes {
    conversation_id [name: 'idx_messages_conversation']
    sender_id [name: 'idx_messages_sender']
    (conversation_id, created_at) [name: 'idx_messages_created_at']
  }
}

Table message_attachments {
  id uuid [pk]
  message_id uuid [not null]
  asset_id uuid [not null]
  order integer [default: 0]
  created_at timestamp [not null, default: `now()`]
}

Table message_reactions {
  id uuid [pk]
  message_id uuid [not null]
  user_id uuid [not null]
  reaction reaction_type [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (message_id, user_id) [unique, name: 'idx_message_reactions_unique']
  }
}

Table message_read_receipts {
  id uuid [pk]
  message_id uuid [not null]
  user_id uuid [not null]
  read_at timestamp [not null]

  indexes {
    (message_id, user_id) [unique, name: 'idx_message_read_receipts_unique']
  }
}

Table friendships {
  id uuid [pk]
  requester_id uuid [not null]
  addressee_id uuid [not null]
  status friendship_status [default: 'pending']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    requester_id [name: 'idx_friendships_requester']
    addressee_id [name: 'idx_friendships_addressee']
  }
}

Table user_presences {
  id uuid [pk]
  user_id uuid [not null, unique]
  status presence_status [default: 'offline']
  custom_status varchar(100)
  last_seen_at timestamp [not null]
  updated_at timestamp [not null, default: `now()`]
}

Table posts {
  id uuid [pk]
  author_id uuid [not null]
  content text
  visibility post_visibility [default: 'public']
  reactions_count integer [default: 0]
  comments_count integer [default: 0]
  shares_count integer [default: 0]
  is_edited boolean [default: false]
  edited_at timestamp
  original_post_id uuid
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp

  indexes {
    author_id [name: 'idx_posts_author']
    (author_id, visibility, created_at) [name: 'idx_posts_feed']
  }
}

Table post_attachments {
  id uuid [pk]
  post_id uuid [not null]
  asset_id uuid [not null]
  order integer [default: 0]
  created_at timestamp [not null, default: `now()`]
}

Table post_reactions {
  id uuid [pk]
  post_id uuid [not null]
  user_id uuid [not null]
  reaction reaction_type [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (post_id, user_id) [unique, name: 'idx_post_reactions_unique']
  }
}

Table post_comments {
  id uuid [pk]
  post_id uuid [not null]
  author_id uuid [not null]
  parent_comment_id uuid
  content text [not null]
  reactions_count integer [default: 0]
  replies_count integer [default: 0]
  is_edited boolean [default: false]
  edited_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp

  indexes {
    post_id [name: 'idx_post_comments_post']
    author_id [name: 'idx_post_comments_author']
  }
}

Table comment_reactions {
  id uuid [pk]
  comment_id uuid [not null]
  user_id uuid [not null]
  reaction reaction_type [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (comment_id, user_id) [unique, name: 'idx_comment_reactions_unique']
  }
}

Table notifications {
  id uuid [pk]
  user_id uuid [not null]
  type notification_type [not null]
  title varchar(255) [not null]
  content text
  data jsonb
  is_read boolean [default: false]
  read_at timestamp
  actor_id uuid
  reference_id uuid
  reference_type varchar(50)
  created_at timestamp [not null, default: `now()`]

  indexes {
    user_id [name: 'idx_notifications_user']
    (user_id, is_read) [name: 'idx_notifications_unread']
  }
}

// ==================== RELATIONSHIPS ====================

// User relationships
Ref: conversations.created_by_id > users.id
Ref: conversation_participants.user_id > users.id
Ref: messages.sender_id > users.id
Ref: message_reactions.user_id > users.id
Ref: message_read_receipts.user_id > users.id
Ref: friendships.requester_id > users.id
Ref: friendships.addressee_id > users.id
Ref: user_presences.user_id - users.id
Ref: posts.author_id > users.id
Ref: post_reactions.user_id > users.id
Ref: post_comments.author_id > users.id
Ref: comment_reactions.user_id > users.id
Ref: notifications.user_id > users.id
Ref: notifications.actor_id > users.id

// Conversation relationships
Ref: conversation_participants.conversation_id > conversations.id
Ref: messages.conversation_id > conversations.id
Ref: conversations.last_message_id - messages.id

// Message relationships
Ref: message_attachments.message_id > messages.id
Ref: message_reactions.message_id > messages.id
Ref: message_read_receipts.message_id > messages.id
Ref: messages.reply_to_id - messages.id
Ref: messages.forwarded_from_id - messages.id

// Participant relationships
Ref: conversation_participants.last_read_message_id - messages.id

// Asset relationships
Ref: message_attachments.asset_id > assets.id
Ref: post_attachments.asset_id > assets.id

// Post relationships
Ref: post_attachments.post_id > posts.id
Ref: post_reactions.post_id > posts.id
Ref: post_comments.post_id > posts.id
Ref: posts.original_post_id - posts.id

// Comment relationships
Ref: post_comments.parent_comment_id - post_comments.id
Ref: comment_reactions.comment_id > post_comments.id
