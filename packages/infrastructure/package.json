{
  "name": "@social-chat/infrastructure",
  "version": "0.0.1",
  "description": "Infrastructure layer with database, cache, external services, and file storage for Social Chat",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.ts\"",
    "lint:fix": "eslint \"**/*.ts\" --fix",
    "migration:run": "typeorm migration:run -d dist/database/typeorm.config.js",
    "migration:revert": "typeorm migration:revert -d dist/database/typeorm.config.js",
    "migration:generate": "typeorm migration:generate -d dist/database/typeorm.config.js",
    "migration:run:ts": "ts-node --transpile-only ./node_modules/typeorm/cli.js migration:run -d database/typeorm.config.ts",
    "migration:revert:ts": "ts-node --transpile-only ./node_modules/typeorm/cli.js migration:revert -d database/typeorm.config.ts"
  },
  "dependencies": {
    "ioredis": "^5.4.1",
    "jwks-rsa": "^3.1.0",
    "minio": "^8.0.0",
    "nestjs-pino": "^4.0.0",
    "pg": "^8.12.0",
    "typeorm": "^0.3.20",
    "typeorm-transactional": "^0.5.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.4.1",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.1",
    "@nestjs/typeorm": "^10.0.2",
    "axios": "^1.7.2",
    "dotenv": "^16.4.5"
  },
  "publishConfig": {
    "access": "restricted"
  }
}



