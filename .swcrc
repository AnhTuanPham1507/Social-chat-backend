{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "sourceMaps": true,
    "jsc": {
        "parser": {
            "syntax": "typescript",
            "decorators": true,
            "dynamicImport": true
        },
        "transform": {
            "legacyDecorator": true,
            "decoratorMetadata": true
        },
        "keepClassNames": true,
        "target": "es2021"
    },
    "module": {
        "type": "commonjs"
    }
}
