{
  "name": "social-chat-monorepo",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "auth:dev": "yarn workspace @social-chat/auth dev",
    "user:dev": "yarn workspace @social-chat/user dev",
    "asset:dev": "yarn workspace @social-chat/asset dev",
    "feed:dev": "yarn workspace @social-chat/feed dev",
    "lint": "yarn workspaces foreach -pv run lint",
    "lint:fix": "yarn workspaces foreach -pv run lint:fix",
    "clean": "yarn workspaces foreach -pv run clean && rm -rf node_modules",
    "typecheck": "yarn workspaces foreach -pv run typecheck",
    "format": "prettier --write \"apps/**/*.ts\" \"packages/**/*.ts\"",
    "format:check": "prettier --check \"apps/**/*.ts\" \"packages/**/*.ts\"",
    "migration:run": "ts-node -r @swc/register -r reflect-metadata node_modules/typeorm/cli.js migration:run -d packages/infrastructure/postgres/typeorm.config.ts",
    "migration:revert": "ts-node -r @swc/register -r reflect-metadata node_modules/typeorm/cli.js migration:revert -d packages/infrastructure/postgres/typeorm.config.ts",
    "migration:show": "ts-node -r @swc/register -r reflect-metadata node_modules/typeorm/cli.js migration:show -d packages/infrastructure/postgres/typeorm.config.ts",
    "seed:users": "ts-node -r @swc/register -r reflect-metadata scripts/seed-users.ts",
    "seed:friendships": "ts-node -r @swc/register -r reflect-metadata scripts/seed-friendships.ts",
    "seed:posts": "ts-node -T -P apps/feed/tsconfig.json -r reflect-metadata scripts/seed-posts.ts",
    "cli": "ts-node -T -P apps/feed/tsconfig.json -r reflect-metadata scripts/cli/main.ts"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.3.4",
    "@nestjs/common": "^10.4.1",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.1",
    "@nestjs/elasticsearch": "^11.1.0",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.1",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^8.0.1",
    "@nestjs/typeorm": "^10.0.2",
    "axios": "^1.7.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dotenv": "^16.4.5",
    "html-to-text": "^9.0.5",
    "mongoose": "^9.4.1",
    "nestjs-cls": "^5.0.0",
    "passport": "^0.7.0",
    "passport-custom": "^1.1.1",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.28",
    "typeorm-transactional": "^0.5.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.2",
    "@nestjs/testing": "^10.4.1",
    "@swc/cli": "^0.7.10",
    "@swc/core": "^1.15.10",
    "@swc/register": "^0.1.10",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.3.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-unused-imports": "^3.1.0",
    "jest": "^29.7.0",
    "nest-commander": "^3.20.1",
    "nodemon": "^3.1.11",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.1.3",
    "webpack": "^5.104.1",
    "webpack-node-externals": "^3.0.0"
  }
}
