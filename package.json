{
    "name": "social-chat",
    "version": "0.0.1",
    "scripts": {
        "test": "jest --config ./test/jest.config.js --clearCache",
        "test:unit": "jest --config ./test/jest.unit.config.js --clearCache",
        "test:e2e": "jest --config ./test/jest.e2e.config.js --clearCache",
        "test:watch": "jest --config ./test/jest.config.js --watch --clearCache",
        "test:coverage": "jest --config ./test/jest.config.js --coverage --clearCache",
        "test:unit:watch": "jest --config ./test/jest.unit.config.js --watch",
        "test:e2e:watch": "jest --config ./test/jest.e2e.config.js --watch",
        "dev": "nest start --watch",
        "build": "nest build",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
        "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "prettier": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "prettier:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" && npm run lint:fix",
        "typecheck": "tsc --project tsconfig.json --noEmit && tsc-alias -p tsconfig.json",
        "docker:build": "docker build -t social-chat-backend .",
        "docker:run": "docker run -p 3000:3000 social-chat-backend",
        "docker:dev": "docker-compose up -d",
        "docker:staging": "docker-compose -f docker-compose.staging.yml up -d",
        "docker:prod": "docker-compose -f docker-compose.production.yml up -d"
    },
    "author": "",
    "license": "ISC",
    "description": "",
    "dependencies": {
        "@beincom/common": "^0.1.6",
        "@beincom/domain": "^0.1.7",
        "@beincom/infrastructure": "^0.1.6",
        "@nestjs/cli": "^10.1.18",
        "@nestjs/common": "^10.4.1",
        "@nestjs/config": "^3.2.3",
        "@nestjs/core": "^10.4.1",
        "@nestjs/event-emitter": "^3.0.0",
        "@nestjs/jwt": "^10.2.0",
        "@nestjs/microservices": "^10.4.1",
        "@nestjs/passport": "^10.0.3",
        "@nestjs/platform-express": "^11.1.1",
        "@nestjs/swagger": "^7.4.0",
        "@nestjs/typeorm": "^10.0.2",
        "@types/multer": "^1.4.12",
        "amqp-connection-manager": "^4.1.14",
        "amqplib": "^0.10.4",
        "bcrypt": "^5.1.1",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "cookie-parser": "^1.4.6",
        "dotenv": "^16.4.5",
        "express": "^4.18.0",
        "minio": "^8.0.5",
        "multer": "^2.0.0",
        "nestjs-cls": "^6.0.1",
        "nestjs-pino": "^4.4.0",
        "passport": "^0.7.0",
        "passport-google-oauth20": "^2.0.0",
        "passport-local": "^1.0.0",
        "pg": "^8.12.0",
        "pino": "^8.0.0",
        "pino-http": "^10.5.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.1.0",
        "swagger-ui-express": "^5.0.1",
        "ts-node": "^10.9.2",
        "typeorm": "^0.3.11",
        "typeorm-transactional": "^0.5.0"
    },
    "devDependencies": {
        "@faker-js/faker": "^8.4.1",
        "@nestjs/testing": "^11.1.1",
        "@types/bcrypt": "^5.0.2",
        "@types/jest": "^29.5.12",
        "@types/node": "^22.3.0",
        "@types/passport-local": "^1.0.38",
        "@typescript-eslint/eslint-plugin": "^6.0.0",
        "@typescript-eslint/parser": "^6.0.0",
        "eslint": "^8.42.0",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-prettier": "^5.0.0",
        "eslint-plugin-unused-imports": "^4.1.4",
        "jest": "^29.7.0",
        "jest-when": "^3.6.0",
        "prettier": "^3.0.0",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.4",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.1.3"
    }
}
