# ==============================================================================
# SHARED CONFIG (config/.env.common)
# ==============================================================================
APP_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=social-chat-local
DB_SYNCHRONIZE=true

# JWT
JWT_SECRET=abc
JWT_TOKEN_EXPIRE=15m
JWT_REFRESH_TOKEN_EXPIRE=7d

# Keycloak
KEYCLOAK_URL=http://localhost:8888
KEYCLOAK_REALM=social-chat
KEYCLOAK_AUTH_CALLBACK_URL=http://localhost:3000/auth/auth/callback
KEYCLOAK_SOCIAL_ID=social-chat
KEYCLOAK_SOCIAL_SECRET=your-keycloak-secret

# Redis Cache
REDIS_CACHE_PASSWORD=redis123
REDIS_CACHE_HOST=localhost
REDIS_CACHE_TLS=
REDIS_CACHE_PORT=6379
REDIS_CACHE_USERNAME=
REDIS_CACHE_PREFIX=CACHE

# Redis Shared Store
REDIS_SHARED_STORE_PASSWORD=redis123
REDIS_SHARED_STORE_HOST=localhost
REDIS_SHARED_STORE_TLS=
REDIS_SHARED_STORE_PORT=6379
REDIS_SHARED_STORE_USERNAME=
REDIS_SHARED_STORE_HOST_CLUSTER=
REDIS_SHARED_STORE_PREFIX=SHARED

# Kafka
KAFKA_BROKERS=localhost:29092

# Internal Service Communication
INTERNAL_API_KEY=your-internal-api-key-here

# ==============================================================================
# PER-APP CONFIG (config/.env.<app>)
# Each app needs: APP_PORT, APP_URL, KAFKA_CLIENT_ID, KAFKA_GROUP_ID
# ==============================================================================

# Auth (config/.env.auth)
# APP_PORT=3001
# APP_URL=http://localhost:3001
# KAFKA_CLIENT_ID=auth-service
# KAFKA_GROUP_ID=auth-service-group
# USER_SERVICE_URL=http://localhost:3002

# User (config/.env.user)
# APP_PORT=3002
# APP_URL=http://localhost:3002
# KAFKA_CLIENT_ID=user-service
# KAFKA_GROUP_ID=user-service-group

# Asset (config/.env.asset) — also needs R2, imgproxy, coconut vars
# APP_PORT=3003
# APP_URL=http://localhost:3003
# KAFKA_CLIENT_ID=asset-service
# KAFKA_GROUP_ID=asset-service-group
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET=social-chat
# R2_PUBLIC_URL=https://your-bucket.your-domain.com
# IMGPROXY_URL=http://localhost:8080
# IMGPROXY_SECRET=your-secret-string
# COCONUT_API_KEY=your-coconut-api-key
# COCONUT_WEBHOOK_URL=http://your-webhook-url

# Feed (config/.env.feed)
# APP_PORT=3004
# APP_URL=http://localhost:3004
# KAFKA_CLIENT_ID=feed-service
# KAFKA_GROUP_ID=feed-service-group
