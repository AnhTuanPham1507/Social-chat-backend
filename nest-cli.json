{
    "language": "ts",
    "collection": "@nestjs/schematics",
    "sourceRoot": "src",
    "compilerOptions": {
        "plugins": ["@nestjs/swagger/plugin"],
        "paths": {
            "@commons/*": ["./src/commons/*", "./dist/src/commons/*"],
            "@configs/*": ["./src/configs/*", "./dist/src/configs/*"],
            "@infras/*": ["./src/infras/*", "./dist/src/infras/*"],
            "@modules/*": ["./src/modules/*", "./dist/src/modules/*"]
        }
    }
  }
  